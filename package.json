{
  "name": "bilingual-translate-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:e2e": "npm run build && ILMT_E2E_HEADLESS=1 playwright test",
    "test:e2e:headed": "npm run build && playwright test",
    "verify:delivery": "npm test && npx tsc --noEmit && npm run build && node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
